# Backend API Configuration
# The host and port the Flask API will listen on
API_HOST=0.0.0.0
API_PORT=5000
FLASK_ENV=development
FLASK_DEBUG=False

# Database Configuration
# PostgreSQL database connection settings
DB_HOST=192.168.100.30
DB_PORT=5432
DB_NAME=healthcare_research
DB_USER=healthcare_user
DB_PASSWORD=your_secure_password_here

# LLM Service Configuration
# Ollama LLM service connection settings
LLM_HOST=192.168.100.1
LLM_PORT=11434
LLM_MODEL=llama3.2:1b
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# Security Configuration
# Options: 'vulnerable' or 'secure'
SECURITY_MODE=vulnerable
# Generate a secure random key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production
JWT_EXPIRES_HOURS=24

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/healthcare_security.log
AUDIT_LOG_FILE=logs/security_audit.log

# CORS Configuration
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# Query and Rate Limiting
MAX_QUERY_RESULTS=1000
QUERY_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL=300

# Domain Configuration
# Email domain for user accounts
EMAIL_DOMAIN=hospital.com
API_BASE_URL=http://192.168.100.20:5000

# Development Environment (optional overrides)
DEVELOPMENT_DB_HOST=192.168.100.30
DEVELOPMENT_LLM_HOST=192.168.100.1

# Testing Environment (optional overrides)
TESTING_DB_HOST=192.168.100.30
TESTING_LLM_HOST=192.168.100.1
TESTING_API_URL=http://localhost:5000
