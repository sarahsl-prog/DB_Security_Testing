# Docker Frontend Environment Configuration Template
# Copy this file to .env and update with your actual values

# Database Configuration
# Note: In Docker, DB_HOST should match the postgres service name
# DB_NAME defaults to 'healthcare_security'
DB_HOST=postgres
DB_PASSWORD=healthcare_secure_password_123
DB_PORT=5432
DB_NAME=healthcare_security
DB_USER=healthcare_user

# LLM Service Configuration
# Available models: llama-sql:latest, qwen-coder-sql:latest, qwen3-sql:latest
#
LLM_HOST=ollama
LLM_PORT=11434
LLM_MODEL=qwen-coder-sql:latest

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_BACKEND_HOST=localhost

# Security Configuration
SECURITY_MODE=vulnerable
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# Logging Configuration (for reference only - actual logs are in backend)
LOG_LEVEL=INFO
LOG_FILE=logs/healthcare_security.log
AUDIT_LOG_FILE=logs/security_audit.log

# Domain Configuration
EMAIL_DOMAIN=hospital.com
