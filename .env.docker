# Healthcare Security Research Platform - Docker Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
# Note: In Docker, DB_HOST should match the postgres service name
# DB_NAME defaults to 'healthcare_security'
DB_HOST=postgres
DB_PASSWORD=healthcare_secure_password_123
DB_PORT=5432
DB_NAME=healthcare_security
DB_USER=healthcare_user

# LLM Service Configuration
LLM_HOST=ollama
LLM_PORT=11434
LLM_MODEL=deepseek-r1:latest

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
FLASK_ENV=development
FLASK_DEBUG=False

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_BACKEND_HOST=localhost

# Documentation Port (optional)
DOCS_PORT=8080

# Security Configuration
SECURITY_MODE=vulnerable
SECRET_KEY=GENERATE_A_SECURE_RANDOM_KEY_HERE
JWT_SECRET_KEY=GENERATE_A_SECURE_RANDOM_JWT_KEY_HERE

# Logging
LOG_LEVEL=INFO

# CORS (use * for development, specific origins for production)
CORS_ORIGINS=*

# Production Settings (uncomment for production)
# FLASK_ENV=production
# SECURITY_MODE=secure
# CORS_ORIGINS=https://yourdomain.com
# LOG_LEVEL=WARNING
