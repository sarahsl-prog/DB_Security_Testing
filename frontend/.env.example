# Frontend Environment Configuration Template
# Copy this file to .env and update with your actual values

# Backend API Server Configuration
BACKEND_HOST=192.168.100.20
BACKEND_PORT=5000

# Database Configuration (for reference/display only - frontend doesn't connect directly)
DB_HOST=192.168.100.30
DB_PORT=5432
DB_NAME=healthcare_security
DB_USER=healthcare_user
DB_PASSWORD=your_password_here

# LLM Service Configuration (for reference/display only - frontend doesn't connect directly)
LLM_HOST=192.168.100.1
LLM_PORT=11434
LLM_MODEL=llama3.1

# Security Configuration
SECURITY_MODE=vulnerable
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# Logging Configuration (for reference only - actual logs are in backend)
LOG_LEVEL=INFO
LOG_FILE=logs/healthcare_security.log
AUDIT_LOG_FILE=logs/security_audit.log

# Domain Configuration
EMAIL_DOMAIN=hospital.com
