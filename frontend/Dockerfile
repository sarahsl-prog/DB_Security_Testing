# Healthcare Security Research Platform - Frontend Dockerfile

# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build arguments for environment variables
ARG VITE_BACKEND_HOST=localhost
ARG VITE_BACKEND_PORT=5000

# Create .env file for build
RUN echo "VITE_BACKEND_HOST=${VITE_BACKEND_HOST}" > .env && \
    echo "VITE_BACKEND_PORT=${VITE_BACKEND_PORT}" >> .env

# Build application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
